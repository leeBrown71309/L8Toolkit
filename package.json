{
  "name": "l8-tools-kits",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test scripts",
    "tauri": "tauri",
    "app:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-release-app.ps1 && tauri dev --config src-tauri/tauri.dev.conf.json",
    "app:build": "tauri build",
    "dev:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/remove-dev-app.ps1",
    "release:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-release.ps1",
    "release:manifest": "bun scripts/make-update-manifest.ts",
    "version:next": "bun scripts/bump-version.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
